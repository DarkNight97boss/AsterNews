{
  "name": "aster-news",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "import:wp": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/import-wordpress.mts",
    "seed:bulk": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed-bulk.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "pagespeed": "node --env-file-if-exists=.env.local --import tsx scripts/pagespeed.mts",
    "seed:demo": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/seed-demo.mts",
    "backup:restore": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/restore-backup.mts",
    "e2e": "playwright test",
    "e2e:isolated": "rm -rf data/pg-e2e .next/cache && PGLITE_DIR=data/pg-e2e DATABASE_URL= POSTGRES_URL= npm run seed:demo && next build && playwright test",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.23.1",
    "@vercel/blob": "^2.8.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "sass": "^1.104.1",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    "chrome >= 95",
    "edge >= 95",
    "firefox >= 95",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "and_chr >= 95",
    "not dead"
  ]
}
